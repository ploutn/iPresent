{
  "name": "church-presenter",
  "private": true,
  "version": "1.0.0",
  "description": "A church presentation management application built with Electron and React.",
  "author": "Marc Iurco",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "deploy": "npm run clean && npm run build:vite && npm run dist",
    "build:vite": "vite build",
    "build:electron": "pnpm run build:vite && electron-builder",
    "dist": "electron-builder",
    "clean": "rimraf .next dist dist-electron",
    "dev:vite": "vite",
    "dev:electron": "nodemon --watch electron.cjs --exec \"electron .\"",
    "dev": "concurrently \"pnpm run dev:vite\" \"wait-on http://localhost:5173 && pnpm run dev:electron\"",
    "start": "vite preview",
    "route-gen": "\"@tanstack/router-cli generate-routefiles\""
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@lexical/html": "^0.29.0",
    "@lexical/list": "^0.29.0",
    "@lexical/react": "^0.29.0",
    "@lexical/rich-text": "^0.29.0",
    "@lexical/selection": "^0.29.0",
    "@radix-ui/react-accordion": "^1.2.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.2.1",
    "lexical": "^0.29.0",
    "lucide-react": "^0.344.0",
    "next": "^15.2.0",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-aria-components": "^1.6.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.6.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "watch": "^1.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.1.2",
    "dmg-builder": "^26.0.12",
    "electron": "^35.0.3",
    "electron-builder": "^24.13.3",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.35",
    "rimraf": "^5.0.10",
    "rollup-plugin-visualizer": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.1",
    "vite-electron-plugin": "^0.8.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.1.3",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=0.6.0"
  },
  "build": {
    "productName": "Church Presenter",
    "appId": "com.example.churchpresenter",
    "directories": {
      "output": "release/${version}",
      "buildResources": "dist"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/app-icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/app-icon.png"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp"
    ]
  }
}
